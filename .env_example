# Copy to .env and fill in values. Do NOT commit .env.

# LiteLLM proxy (docker-compose + local curl / test scripts)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_BASE=http://localhost:4000
LITELLM_MASTER_KEY=

# Production database secret used by Cloud Run deploys.
# Local docker-compose ignores DATABASE_URL and uses LOCAL_DATABASE_URL instead.
DATABASE_URL_SECRET=DATABASE_URL

# Local database (docker-compose only; keep separate from production)
LOCAL_DATABASE_URL=postgresql://litellm:litellm_local@postgres:5432/litellm_local
DATABASE_URL=
USE_PRISMA_MIGRATE=
ENFORCE_PRISMA_MIGRATION_CHECK=
# Set only on a no-traffic, single-instance migration revision.
RUN_LITELLM_MIGRATIONS=false

# GCP — used by litellm_config.yaml for all vertex_ai/* models (project + region)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Optional host override for local Docker. Defaults to the standard gcloud ADC
# path used on this workstation; the credential is mounted read-only.
# LOCAL_GOOGLE_ADC_PATH=/Users/jason/.config/gcloud/application_default_credentials.json
# Optional only if LiteLLM's bundled Gemini Omni Flash 1.1 pricing metadata is unavailable.
# GEMINI_OMNI_INPUT_COST_PER_TOKEN=
# GEMINI_OMNI_OUTPUT_COST_PER_TOKEN=
# GEMINI_OMNI_OUTPUT_VIDEO_COST_PER_TOKEN=
# GEMINI_OMNI_MAX_CONTENT_BYTES=536870912

# AI API Keys
OPENAI_API_KEY=
GROK_API_KEY=
# Grok Imagine Video 1.5 generation, image-to-video, reference images, and
# preset voices are enabled by default. Keep only its undocumented editing and
# extension operations behind the separate compatibility guard.
GROK_VIDEO_15_VIDEO_OPERATIONS_VERIFIED=false
# Grok Imagine Video 1.5 (optional pricing overrides for grok-video-1.5)
# GROK_VIDEO_15_PRICE_PER_SECOND_480P=0.08
# GROK_VIDEO_15_PRICE_PER_SECOND_720P=0.14
# GROK_VIDEO_15_PRICE_PER_SECOND_1080P=0.25
# GROK_VIDEO_15_PRICE_PER_REFERENCE_IMAGE=0.01
BYTEDANCE_API_KEY=
# Seedream 5 (ModelArk image generation; optional pricing overrides)
# SEEDREAM_ARK_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDREAM_5_0_PRICE_PER_IMAGE=0.035
# SEEDREAM_5_0_LITE_PRICE_PER_IMAGE=0.035
# SEEDREAM_5_0_PRO_1K_PRICE_PER_IMAGE=0.045
# SEEDREAM_5_0_PRO_2K_PRICE_PER_IMAGE=0.09
# SEEDREAM_5_0_PRO_ADDITIONAL_INPUT_PRICE=0.003
# SEEDREAM_WEB_SEARCH_PRICE_PER_REQUEST=0.0006
# Seedance 2.0 (optional tuning)
# SEEDANCE_ARK_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_ARK_MODEL=dreamina-seedance-2-0-260128
# SEEDANCE_POLL_INTERVAL_S=10
# SEEDANCE_POLL_TIMEOUT_S=1200
# SEEDANCE_SYNC_WAIT_S=240
# Append-only JSONL of every submitted ARK task id (recovery after timeouts):
# SEEDANCE_TASK_LEDGER_PATH=./seedance_task_ledger.jsonl
# Seedance 2.5 uses the LAS durable-job endpoint and a separate key.
SEEDANCE_2_5_API_KEY=
# SEEDANCE_2_5_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com/api/v1
# SEEDANCE_2_5_PRICE_PER_SECOND_480P=0.2055855
# SEEDANCE_2_5_PRICE_PER_SECOND_720P=0.462075
ELEVENLABS_API_KEY=

# Durable video generation jobs. Cloud Tasks values are optional for local
# development; POST/GET still work and status can be reconciled manually.
GENERATION_JOB_MAX_AGE_SECONDS=7200
GENERATION_RETENTION_DAYS=30
GENERATION_MAX_UPLOAD_BYTES=104857600
GENERATION_MAX_CONTENT_BYTES=2147483648
GENERATION_INTERNAL_SECRET=
# Canonical deployed HTTPS origin used in content URLs. Leave blank locally so
# request.base_url is used; the deploy script sets this to the Cloud Run URL.
GATEWAY_PUBLIC_BASE_URL=
GENERATION_CALLBACK_BASE_URL=
# Optional. Live Veo V2 uses LiteLLM. Set this only for vertex_veo_direct.
# Apply a GCS lifecycle of 30 days or less (ADR-001) and grant the Cloud Run
# service account storage.objects.create/get on the prefix.
VEO_OUTPUT_GCS_PREFIX=
GENERATION_POLL_QUEUE_PROJECT=
GENERATION_POLL_QUEUE_LOCATION=
GENERATION_POLL_QUEUE_NAME=ai-generation-polls
GENERATION_POLL_TARGET_URL=
GENERATION_POLL_AUDIENCE=
GENERATION_POLL_SERVICE_ACCOUNT_EMAIL=
