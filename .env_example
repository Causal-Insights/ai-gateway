# Copy to .env and fill in values. Do NOT commit .env.

# LiteLLM proxy auth
LITELLM_MASTER_KEY=

# Database (optional; required for DB-backed key management)
DATABASE_URL=
# DIRECT_URL=
USE_PRISMA_MIGRATE=

# AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
BYTEDANCE_API_KEY=
# Seedance 2.0 (optional tuning)
# SEEDANCE_ARK_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDANCE_ARK_MODEL=dreamina-seedance-2-0-260128
# SEEDANCE_POLL_INTERVAL_S=10
# SEEDANCE_POLL_TIMEOUT_S=1200
ELEVENLABS_API_KEY=

# Local MLX-VLM settings (optional)
MLX_VLM_MODEL=
MLX_VLM_PORT=
MLX_VLM_API_BASE=
MLX_VLM_API_KEY=
MLX_VLM_PYENV=

# Vertex AI / GCP (optional; for veo/vertex models)
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=
VERTEXAI_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=

# Supabase (optional; if used by dependent apps)
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ASSETS_BUCKET=

# Email (optional)
EMAIL_REPLY_TO=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=

# App settings (optional)
PUBLIC_APP_URL=
APP_BASE_URL=

# Job/download security (optional)
DOWNLOAD_LINK_MAX_USES=
DOWNLOAD_LINK_TTL_HOURS=
DOWNLOAD_LINK_SECRET=
JOB_PROCESS_SECRET=
GUEST_TOKEN_PEPPER=

# Stripe (optional)
STRIPE_PRODUCT_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

