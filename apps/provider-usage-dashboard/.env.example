# Reporting credentials only. Existing Gateway inference variables are not read.
OPENAI_USAGE_API_KEY=
XAI_USAGE_API_KEY=
# Optional for team-scoped xAI keys: discovered through the official validation API.
XAI_TEAM_ID=
BYTEPLUS_BILLING_ACCESS_KEY_ID=
BYTEPLUS_BILLING_SECRET_ACCESS_KEY=
ELEVENLABS_USAGE_API_KEY=
MINIMAX_USAGE_API_KEY=

GOOGLE_CLOUD_PROJECT=ai-gateway-495414
GOOGLE_BILLING_TABLE=
GOOGLE_BILLING_MAX_BYTES=10000000000
FIRESTORE_DATABASE=provider-usage-dashboard

# SELECT-only database users; never use the production Gateway master connection.
GATEWAY_REPORTING_DATABASE_URL=
MAGICLENS_REPORTING_DATABASE_URL=

# Local file cache is the default. Cloud Run always uses Firestore.
DASHBOARD_CACHE_PATH=.local/reporting.json
# DASHBOARD_STORE=firestore

# Optional organization scope restriction. IDs are identifiers, never API key secrets.
OPENAI_PROJECT_IDS=
